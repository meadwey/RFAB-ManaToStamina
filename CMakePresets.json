{
  "version": 3,
  "configurePresets": [
    {
      "name": "x64-windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/x64-windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-windows",
      "configurePreset": "x64-windows"
    }
  ]
}
